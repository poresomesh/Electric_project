# GEMINI_API_KEY: Required for Gemini AI API calls (notebook digitizer).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL after deploy (optional).
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon Postgres connection string (required on Vercel so all
# browsers share the same campus data). Leave empty for local file storage
# in data/campus-state.json during npm run dev.
DATABASE_URL=""

# Supabase cloud storage (preferred over DATABASE_URL when both are set).
# Keep the service-role key server-side only; never expose it to the browser.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Server-side authentication records. Never expose this through VITE_* vars.
# Store a JSON array with public user metadata and scrypt password hashes only on the server.
AUTH_USERS_JSON=[{"id":"usr-admin","username":"admin","name":"Administrator","role":"admin","assignedBlockId":"ALL","department":"Administration","designation":"Administrator","passwordHash":"scrypt$<salt-hex>$<digest-hex>"}]"[{\"id\":\"usr-admin\",\"username\":\"admin\",\"name\":\"Administrator\",\"role\":\"admin\",\"assignedBlockId\":\"ALL\",\"department\":\"Administration\",\"designation\":\"Administrator\",\"password\":\"change-this-server-secret\"}]"
# New non-admin accounts are initialized with this server-side default.
DEFAULT_USER_PASSWORD=SOL@13"[{\"id\":\"usr-admin\",\"username\":\"admin\",\"name\":\"Administrator\",\"role\":\"admin\",\"assignedBlockId\":\"ALL\",\"department\":\"Administration\",\"designation\":\"Administrator\",\"password\":\"change-this-server-secret\"}]"

